#@base = http://localhost:7071
@base = flat-plants-api.azurewebsites.net

# Paste the deployed app's _master key here (Azure Portal > Function App > Functions > App keys,
# or `az functionapp keys list --name flat-plants-api --resource-group <your-rg>`).
# Not needed when @base is localhost — the local host doesn't enforce function keys.
@adminKey = REDACTED_ADMIN_KEY==

### Subscribe this REST client as a device (run once — needed before nfc/plants writes will work)
# Fake push details are fine locally: ALLOWED_SUBSCRIBE_IPS is empty in local.settings.json so the
# IP check is skipped, and the server never validates these are a real push subscription.
# VS Code's REST Client stores the resulting Set-Cookie and replays it on later requests to {{base}}
# in this file (requires the "rest-client.enableCookies" setting, on by default).
POST {{base}}/subscribe
Content-Type: application/json

{
  "endpoint": "https://example.com/fake-endpoint-for-local-testing",
  "p256dh": "fake-p256dh",
  "auth": "fake-auth",
  "label": "requests.http"
}

### List all plants
GET {{base}}/plants

### Add a plant
POST {{base}}/plants
Content-Type: application/json

{
  "name": "Spider Plant",
  "room": "Bathroom",
  "plant_type": "Spider Plant",
  "watering_interval_days": 3.5
}

### Add a plant
POST {{base}}/plants
Content-Type: application/json

{
  "name": "Calathea Plant",
  "room": "Bathroom",
  "plant_type": "Calathea",
  "watering_interval_days": 3.5
}

### Add another plant
POST {{base}}/plants
Content-Type: application/json

{
  "name": "Ficus Plant",
  "room": "Bathroom",
  "plant_type": "Ficus",
  "watering_interval_days": 14
}

### Add another plant
POST {{base}}/plants
Content-Type: application/json

{
  "name": "Sunflowers",
  "room": "Living Room",
  "plant_type": "Sunflower",
  "watering_interval_days": 2
}

### Update a plant (change watering interval)
PUT {{base}}/plants/bathroom-spider-plant
Content-Type: application/json

{
  "watering_interval_days": 4
}

### Water a plant
GET {{base}}/nfc/bathroom-calathea-plant

### Water a plant
GET {{base}}/nfc/bathroom-ficus-plant

### Water a plant
GET {{base}}/nfc/bathroom-spider-plant

### Delete a plant
DELETE {{base}}/plants/bathroom-calathea-plant
### Delete a plant
DELETE {{base}}/plants/bathroom-spider-plant
### Delete a plant
DELETE {{base}}/plants/bathroom-ficus-plant

### Simulate NFC scan (mark plant as watered)
GET {{base}}/nfc/bathroom-spider-plant

### Get VAPID public key
GET {{base}}/vapid-public-key

### Manually trigger the watering_check timer (admin API — requires @adminKey against the deployed app)
POST {{base}}/admin/functions/watering_check
Content-Type: application/json
x-functions-key: {{adminKey}}

{
  "input": ""
}
